# ==============================================================================
# Sanaka Hospital Patient Case-Taking & EMR System - Environment Variables
# ==============================================================================

# 1. Supabase PostgreSQL Database Connection (Recommended for Production & Vercel)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For Supabase: Project Settings -> Database -> Connection string -> URI (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your_database_password@aws-0-region.pooler.supabase.com:6543/postgres

# Alternative: Separate database parameters (if not using DATABASE_URL)
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your_database_password
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543

# 2. JWT Security & Authentication
SECRET_KEY=your_strong_random_secret_key_here
DEBUG=False

# 3. AI Diagnostic & Clinical Assistant (Optional)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

